MONGO_URI=mongodb://localhost:27017/smartaudit
PORT=4000
# true = deterministic local AI engine (no API key needed)
MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WORKER_CONCURRENCY=3
AI_MAX_CONCURRENCY=2
LOG_LEVEL=info
# Single-tenant demo: every request is scoped to this tenant unless X-Tenant-Id is sent
DEFAULT_TENANT_ID=650000000000000000000001
VITE_API_URL=http://localhost:4000
